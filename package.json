{
  "name": "catalog-service",
  "version": "1.0.0",
  "description": "A catlog management service",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
    "formate:check": "prettier . --check",
    "formate:write": "prettier . --write",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --no-cache --coverage --all --runInBand",
    "test:watch": "jest --no-cache --coverage --all --watch --runInBand"
  },
  "author": "Sagar",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.5",
    "nodemon": "^3.1.2",
    "prettier": "3.2.5",
    "supertest": "7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run lint:fix",
      "npm run formate:write"
    ]
  },
  "dependencies": {
    "config": "^5.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.0",
    "js-yaml": "^5.3.0",
    "mongoose": "^9.9.3",
    "uuid": "^14.0.2",
    "winston": "^3.13.0"
  }
}